<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- NuGet -->
    <PackageId>Katasec.Anthropic.Models</PackageId>
    <Version>0.2.0</Version>
    <Authors>katasec</Authors>
    <Description>AOT-safe Anthropic Messages API wire types and source-generated JSON context, shared by client and server.</Description>
    <PackageTags>anthropic;claude;messages;aot;native-aot</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

</Project>
